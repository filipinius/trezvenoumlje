---
// Toggle + panel around the main nav (default slot). The panel also holds the contact CTA and, on mobile,
// the direct "call" / "e-mail" links once the settings no longer hold placeholders.
import { contactLinks } from '../lib/contact-links';
import { getSettings } from '../lib/content';
import Button from './Button.astro';
const { tel, mailto } = contactLinks(await getSettings());
---
<button type="button" class="menu-toggle" aria-expanded="false" aria-controls="glavni-meni" aria-label="Meni">
  <svg class="icon-closed" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
  <svg class="icon-open" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
</button>
<div id="glavni-meni" class="menu-panel">
  <slot />
  <Button href="/kontakt/" class="menu-cta">Zakažite razgovor</Button>
  {(tel || mailto) && (
    <div class="menu-contact">
      {tel && <Button href={tel} variant="secondary">Pozovite</Button>}
      {mailto && <Button href={mailto} variant="secondary">Pošaljite e-mail</Button>}
    </div>
  )}
</div>
<style>
  /* Useless without JavaScript: the panel is already open then. */
  .menu-toggle { display: none; }
  .menu-panel { flex: 1 0 100%; padding: 0 0 24px; }
  .menu-panel > .menu-cta { display: flex; margin-top: 12px; }
  .menu-contact { display: flex; gap: 10px; margin-top: 12px; }
  .menu-contact > :global(*) { flex: 1; padding-inline: 8px; font-size: var(--tekst-mali); }

  @media (max-width: 899px) {
    :global(.js) .menu-toggle {
      display: flex; align-items: center; justify-content: center; width: 48px; height: 48px; padding: 0;
      border: 1.5px solid var(--linija); border-radius: 10px; background: var(--bela); color: var(--tekst); cursor: pointer;
    }
    .menu-toggle[aria-expanded='false'] .icon-open, .menu-toggle[aria-expanded='true'] .icon-closed { display: none; }
    :global(.js) .menu-panel {
      position: absolute; top: 100%; left: 0; right: 0; max-height: calc(100dvh - 64px); overflow-y: auto;
      padding: 8px var(--gutter) 24px; background: var(--bela); border-bottom: 1px solid var(--linija);
      box-shadow: 0 16px 32px color-mix(in srgb, var(--tekst) 10%, transparent);
    }
    :global(.js) .menu-panel:not([data-open]) { display: none; }
  }

  @media (min-width: 900px) {
    /* The panel dissolves: nav and CTA become items of the header row. */
    .menu-panel { display: contents; }
    .menu-panel > .menu-cta { display: inline-flex; margin-top: 0; padding-inline: 20px; font-size: var(--tekst-mali); }
    .menu-contact { display: none; }
  }
</style>
