---
// Same items as the BreadcrumbList JSON-LD: site paths, first item "Početna", last item the current page.
// On a dark hero the parent sets --putanja-boja (text) and --putanja-link (links).
import { href } from '../lib/site';
interface Props { items: { label: string; path: string }[] }
const { items } = Astro.props;
---
{items.length > 0 && (
  <nav class="breadcrumbs" aria-label="Putanja">
    <ol>
      {items.map((item, i) => (
        <li>
          {i > 0 && <span class="sep" aria-hidden="true">/</span>}
          {i < items.length - 1 ? <a href={href(item.path)}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))}
    </ol>
  </nav>
)}
<style>
  .breadcrumbs { font-size: var(--tekst-sitan); color: var(--putanja-boja, var(--tekst-prigusen)); }
  ol { display: flex; flex-wrap: wrap; gap: 0 6px; margin: 0; padding: 0; list-style: none; }
  li { display: inline-flex; align-items: center; gap: 6px; min-height: 44px; }
  a { display: inline-flex; align-items: center; min-height: 44px; color: var(--putanja-link, var(--zelena)); }
  a:hover { color: var(--putanja-link, var(--plava)); }
</style>
