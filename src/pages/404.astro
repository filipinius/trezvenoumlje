---
// Emitted as dist/404.html. The host serves it for unknown addresses at any depth, so every URL in it
// must start at the site root: links go through Button/href(), never a relative path.
import Button from '../components/Button.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

const seo = {
  title: 'Stranica nije pronađena',
  description: 'Stranica koju ste tražili ne postoji ili je premeštena. Vratite se na početnu ili izaberite jednu od glavnih stranica.',
  path: '/404/',
  canonical: false as const,
  noindex: true,
};
const links = [
  { label: 'Početna', path: '/' },
  { label: 'Usluge', path: '/usluge/' },
  { label: 'Trezvene misli', path: '/resursi/' },
  { label: 'Kontakt', path: '/kontakt/' },
];
---
<BaseLayout seo={seo}>
  <section class="hero container">
    <h1>Stranica nije pronađena</h1>
    <p>Adresa je možda promenjena ili stranica više ne postoji.</p>
    <ul>
      {links.map((link, i) => (
        <li><Button href={link.path} variant={i === 0 ? 'primary' : 'secondary'}>{link.label}</Button></li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .hero { display: flex; flex-direction: column; gap: 18px; padding-block: clamp(24px, 5vw, 64px) clamp(56px, 7vw, 96px); }
  h1, p { margin: 0; }
  p { font-size: var(--uvod); color: var(--tekst-sekundarni); }
  ul { display: flex; flex-wrap: wrap; gap: 12px; margin: 14px 0 0; padding: 0; list-style: none; }
</style>
