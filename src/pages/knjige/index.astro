---
// The "Knjige i publikacije" section of the Resources artboard as its own page.
// A book with its own section of the site (`spoljnaStranica`) is a band that links there; the others open "Kako do knjige".
import { Image } from 'astro:assets';
import BookCover from '../../components/BookCover.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Dialog from '../../components/Dialog.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getVisible } from '../../lib/content';
import { getImageAsset } from '../../lib/images';
import { bookPath, coverAlt, hasDetailPage } from '../../lib/knjige';
import { href } from '../../lib/site';

const seo = {
  title: 'Knjige',
  description: 'Knjige i publikacije dr Dragana Vukadinovića, osnivača centra Trezvenoumlje.',
  path: '/knjige/',
};
const breadcrumbs = [
  { label: 'Početna', path: '/' },
  { label: 'Knjige', path: '/knjige/' },
];

const books = (await getVisible('knjige')).sort((a, b) => a.data.redosled - b.data.redosled);
const featured = books.filter((book) => book.data.spoljnaStranica);
const others = books.filter((book) => !book.data.spoljnaStranica);
const dialogId = (slug: string) => `knjiga-${slug}`;
const present = (...values: (string | undefined)[]) => values.filter((v): v is string => !!v);
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs} renderBreadcrumbs={false}>
  <section class="hero container">
    <Breadcrumbs items={breadcrumbs} />
    <span class="nadnaslov">Knjige i publikacije</span>
    <h1>Knjige dr Dragana Vukadinovića</h1>
  </section>

  <div class="container books">
    {featured.map(({ data: book }) => (
      <a class="feature" href={href(book.spoljnaStranica!)}>
        {book.korica
          ? <Image class="feature-cover" src={getImageAsset(book.korica)} alt={coverAlt(book.naslov)} width={96} height={144} />
          : <BookCover class="feature-cover" naslov={book.naslov} autor={book.autor} />}
        <div class="feature-text">
          {book.oznaka && <Text class="nadnaslov" value={book.oznaka} />}
          <h2><Text value={book.naslov} /></h2>
          {book.opis && <Text as="p" value={book.opis} />}
          <StatusBadge status={book.status} />
        </div>
        <span class="feature-more">Pogledajte knjigu <span aria-hidden="true">→</span></span>
      </a>
    ))}

    {others.length > 0 && (
      <div class="book-grid">
        {others.map((entry) => {
          const book = entry.data;
          const line = present(book.izdavac, book.godina, book.isbn && `ISBN ${book.isbn}`).join(' · ');
          const publisher = present(book.izdavac, book.godina).join(', ');
          return (
            <article class="book">
              {book.korica
                ? <Image class="book-image" src={getImageAsset(book.korica)} alt={coverAlt(book.naslov)} width={320} height={480} loading="lazy" />
                : <BookCover naslov={book.naslov} autor={book.autor} />}
              <h2>
                {hasDetailPage(entry)
                  ? <a href={href(bookPath(book.slug))}><Text value={book.naslov} /></a>
                  : <Text value={book.naslov} />}
              </h2>
              {line && <Text class="book-line" value={line} />}
              <StatusBadge status={book.status} />
              <button type="button" class="book-how" data-dialog-open={dialogId(book.slug)} aria-label={`Kako do knjige: ${book.naslov}`}>
                Kako do knjige <span aria-hidden="true">→</span>
              </button>
              <Dialog id={dialogId(book.slug)} title="Kako do knjige">
                <dl class="book-facts">
                  <dt>Naslov</dt><Text as="dd" class="book-title" value={book.naslov} />
                  {publisher && <><dt>Izdavač</dt><Text as="dd" value={publisher} /></>}
                  {book.isbn && <><dt>ISBN</dt><Text as="dd" value={book.isbn} /></>}
                  {book.nabavka && <><dt>Gde se nabavlja</dt><Text as="dd" value={book.nabavka} /></>}
                </dl>
                {book.opis && <Text as="p" class="book-about" value={book.opis} />}
                <Button href="/kontakt/" class="book-ask">Pošaljite upit</Button>
              </Dialog>
            </article>
          );
        })}
      </div>
    )}
  </div>
</BaseLayout>

<style>
  h1, h2 { margin: 0; }
  .nadnaslov { display: block; line-height: 1.65; }

  .hero { display: flex; flex-direction: column; gap: 12px; padding-block: clamp(24px, 5vw, 64px) 36px; }
  h1 { max-width: 900px; }

  .books { display: flex; flex-direction: column; gap: 36px; padding-bottom: clamp(56px, 7vw, 104px); }

  /* Knjiga sa sopstvenom stranicom */
  .feature {
    display: flex; flex-wrap: wrap; align-items: center; gap: 24px 40px; padding: 28px 32px;
    border-radius: var(--radius-l); background: var(--zelena); color: var(--bela); text-decoration: none;
  }
  .feature:hover { background: var(--zelena-hover); color: var(--bela); }
  .feature:focus-visible { outline-offset: 3px; }
  .feature-cover { flex: none; width: 96px; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 4px 8px 8px 4px; }
  .feature :global(.book-cover) { --cover-shadow: 0 0 0 transparent; }
  .feature-text { flex: 1 1 360px; min-width: 0; display: flex; flex-direction: column; gap: 6px; }
  .feature-text .nadnaslov, .feature-text p { color: var(--zelena-tinta); }
  .feature-text h2 { font-size: var(--h3); }
  .feature-text p { margin: 0; }
  .feature-more { font-family: var(--font-naslov); font-weight: 600; }

  /* Ostale knjige */
  .book-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr)); gap: 28px; }
  .book { min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .book-image {
    display: block; width: 100%; height: auto; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 6px 12px 12px 6px;
    box-shadow: 0 12px 24px color-mix(in srgb, var(--tekst) 12%, transparent);
  }
  .book h2 { font-size: var(--uvod); line-height: 1.3; }
  .book-line { font-size: var(--tekst-mali); color: var(--tekst-prigusen); }
  .book-how {
    align-self: flex-start; min-height: 44px; padding: 0; border: 0; background: none; color: var(--zelena); cursor: pointer;
    font-family: var(--font-naslov); font-weight: 600; font-size: var(--tekst-mali); text-decoration: underline; text-underline-offset: 4px;
  }
  .book-how:hover { color: var(--plava); }

  /* Overlay „Kako do knjige“ */
  .book-facts { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 0; }
  .book-facts dt { color: var(--tekst-prigusen); }
  .book-facts :global(dd) { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .book-title { font-weight: 700; }
  .book-about { margin: 18px 0; font-size: var(--tekst-mali); color: var(--tekst-sekundarni); }
  .book-facts + :global(.book-ask) { margin-top: 18px; }
  :global(dialog.overlay[id^='knjiga-'] .book-ask) { display: flex; min-height: 52px; }
  :global(dialog.overlay[id^='knjiga-'] .overlay-title) { font-size: var(--h3); }
  @media (min-width: 700px) {
    :global(dialog.overlay[id^='knjiga-']) { max-width: 560px; }
  }

  /* Without JavaScript the button cannot open anything: the details follow each card as a plain block. */
  :global(html:not(.js) dialog.overlay[id^='knjiga-']) {
    position: static; display: block; width: 100%; max-width: none; height: auto; margin: 0; border: 1px solid var(--linija);
  }
  :global(html:not(.js) dialog.overlay[id^='knjiga-'] .overlay-inner) { min-height: 0; padding: 20px; }
  :global(html:not(.js) dialog.overlay[id^='knjiga-'] .overlay-close) { display: none; }
  :global(html:not(.js)) .book-how { display: none; }
  :global(html:not(.js)) .book-facts { grid-template-columns: 1fr; gap: 2px; }
  :global(html:not(.js)) .book-facts :global(dd) { margin-bottom: 8px; }

  @media (max-width: 699px) {
    .hero { padding-bottom: 28px; }
    .feature { padding: 24px 20px; }
    .book-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 20px; }
    /* The static details need the full width to be readable. */
    :global(html:not(.js)) .book-grid { grid-template-columns: minmax(0, 1fr); }
    :global(html:not(.js)) .book :global(.book-cover), :global(html:not(.js)) .book-image { max-width: 240px; }
    .book-facts { grid-template-columns: 1fr; gap: 2px; }
    .book-facts :global(dd) { margin-bottom: 8px; }
  }
</style>
