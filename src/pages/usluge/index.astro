---
import AudienceCard from '../../components/AudienceCard.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import EmergencyNote from '../../components/EmergencyNote.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import ServiceList from '../../components/ServiceList.astro';
import { NAZIVI_KATEGORIJA_PITANJA } from '../../content/schemas';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFamilyAudiences, getFaq, getVisible } from '../../lib/content';
import { faqPage } from '../../lib/jsonld';

const INTRO = 'Edukativni i savetodavni razgovori u okviru nezdravstvene delatnosti. Prvi razgovor služi da razumemo potrebu i dogovorimo sledeći korak.';

const seo = { title: 'Usluge za pojedince i porodice', description: INTRO, path: '/usluge/' };
const breadcrumbs = [
  { label: 'Početna', path: '/' },
  { label: 'Usluge', path: '/usluge/' },
];

// The first three cards of "Kome pomažemo" on Home, in the same order.
const groups = await getFamilyAudiences();

const services = (await getVisible('usluge')).sort((a, b) => a.data.redosled - b.data.redosled);

const general = await getFaq('opste');
const privacy = await getFaq('privatnost');
const faqLd = faqPage([...general, ...privacy].map((q) => q.data));
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs} renderBreadcrumbs={false} jsonLd={faqLd ? [faqLd] : []}>
  <section class="hero container">
    <div class="hero-text">
      <Breadcrumbs items={breadcrumbs} />
      <h1>Usluge za pojedince i porodice</h1>
      <p class="intro">{INTRO}</p>
    </div>
    <div class="hero-note" role="note">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
      <span>Usluge nisu lečenje ni dijagnostika. Kada je potreban lekar ili ustanova, jasno ćemo vas uputiti.</span>
    </div>
  </section>

  {groups.length > 0 && (
    <section class="container audiences" aria-label="Kome pomažemo">
      <ul class="audience-grid">
        {groups.map(({ data: g }) => <AudienceCard title={g.naziv} text={g.uvod} path={`/usluge/${g.slug}/`} icon={g.slug} heading="h2" />)}
      </ul>
    </section>
  )}

  {services.length > 0 && (
    <section class="container services" aria-label="Lista usluga">
      <ServiceList services={services} />
    </section>
  )}

  <section class="band-light" aria-labelledby="programi-h">
    <div class="container programs">
      <div class="programs-title">
        <span class="nadnaslov">Programi</span>
        <h2 id="programi-h">Šest programa, jedna logika: razumevanje pre promene</h2>
      </div>
      <Button href="/programi/" variant="secondary">Pogledajte programe</Button>
    </div>
  </section>

  <FaqBlock questions={general} category="opste" />
  <FaqBlock questions={privacy} category="privatnost" heading={NAZIVI_KATEGORIJA_PITANJA.privatnost} />

  <div class="container closing">
    <EmergencyNote />
  </div>
</BaseLayout>

<style>
  h2 { margin: 0; }
  .nadnaslov { display: block; }
  .band-light { background: var(--pesak-svetli); }

  /* Hero */
  .hero { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 32px 64px; padding-block: clamp(24px, 5vw, 64px) 40px; }
  .hero-text { flex: 2 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 18px; }
  h1 { margin: 0; }
  .intro { margin: 0; max-width: 720px; font-size: var(--uvod); color: var(--tekst-sekundarni); }
  .hero-note {
    flex: 1 1 300px; min-width: 0; display: flex; gap: 12px; padding: 20px 22px;
    background: var(--plava-tinta); border-radius: 14px; font-size: var(--tekst-mali);
  }
  .hero-note svg { flex: none; margin-top: 2px; color: var(--plava); }

  /* Ciljne grupe: kartice sa Početne */
  .audiences { padding-bottom: clamp(32px, 4vw, 56px); }
  .audience-grid { display: flex; flex-wrap: wrap; gap: 20px; margin: 0; padding: 0; list-style: none; }

  .services { padding-bottom: clamp(56px, 7vw, 96px); }

  /* Programi */
  .programs {
    display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px 40px;
    padding-block: clamp(48px, 6vw, 80px);
  }
  .programs-title { display: flex; flex-direction: column; gap: 12px; max-width: 720px; }

  .closing { padding-bottom: clamp(56px, 7vw, 96px); }

  @media (max-width: 699px) {
    .hero { padding-bottom: 32px; }
    .audience-grid { flex-direction: column; gap: 14px; }
  }
</style>
