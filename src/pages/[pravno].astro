---
// The legal pages, one per visible `pravno` entry. Static routes (/kontakt/, /o-nama/ …) take priority over this one.
// A draft is built in preview only: in production the footer links stay broken until the text is published,
// and the post-build link check is what stops such a build.
import { render, type CollectionEntry } from 'astro:content';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Prose from '../components/Prose.astro';
import StatusBadge from '../components/StatusBadge.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getVisible } from '../lib/content';
import { formatDate, isoDate } from '../lib/date';
import { site } from '../lib/site';
import { isIndexable } from '../lib/status';

export async function getStaticPaths() {
  return (await getVisible('pravno')).map((entry) => ({ params: { pravno: entry.data.slug }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'pravno'> }
const { entry } = Astro.props;
const { data } = entry;
const path = `/${data.slug}/`;

const seo = {
  title: data.naslov,
  description: `${data.naslov} centra Trezvenoumlje: pravila i informacije za posetioce sajta.`,
  path,
  noindex: !isIndexable({ status: data.status, noindex: data.seo?.noindex }, site.env),
};
const breadcrumbs = [
  { label: 'Početna', path: '/' },
  { label: data.naslov, path },
];
const { Content } = await render(entry);
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs} renderBreadcrumbs={false}>
  <article>
    <header class="hero container">
      <Breadcrumbs items={breadcrumbs} />
      <h1>{data.naslov}</h1>
      {data.datumIzmene && (
        <p class="meta">Poslednja izmena: <time datetime={isoDate(data.datumIzmene)}>{formatDate(data.datumIzmene)}</time></p>
      )}
      <StatusBadge status={data.status} />
    </header>
    <div class="container body">
      <Prose><Content /></Prose>
    </div>
  </article>
</BaseLayout>

<style>
  .hero, .body { max-width: calc(820px + 2 * var(--gutter)); }
  .hero { display: flex; flex-direction: column; gap: 18px; padding-block: clamp(24px, 5vw, 64px) 32px; }
  h1 { margin: 0; }
  .meta { margin: 0; font-size: var(--tekst-sitan); color: var(--tekst-prigusen); }
  .body { padding-bottom: clamp(56px, 7vw, 96px); }
</style>
