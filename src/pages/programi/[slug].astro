---
// One program. No artboard of its own: the hero, FAQ block and CTA band used across the site, filled from the entry.
import type { CollectionEntry } from 'astro:content';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CtaBand from '../../components/CtaBand.astro';
import EmergencyNote from '../../components/EmergencyNote.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import PriceNote from '../../components/PriceNote.astro';
import StatusBadge from '../../components/StatusBadge.astro';
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFaq, getVisible } from '../../lib/content';
import { ogImageUrl } from '../../lib/images';
import { faqPage } from '../../lib/jsonld';
import { priceLabel } from '../../lib/price';

export async function getStaticPaths() {
  return (await getVisible('programi')).map((program) => ({ params: { slug: program.data.slug }, props: { program } }));
}
interface Props { program: CollectionEntry<'programi'> }
const { data: program } = Astro.props.program;
const path = `/programi/${program.slug}/`;

const MIN_DESCRIPTION = 50;
const description = program.opis.length >= MIN_DESCRIPTION ? program.opis : `${program.opis} — ${program.publika} · ${program.format}`;
const seo = {
  title: program.seo?.naslov ?? program.naziv,
  description: program.seo?.opis ?? description,
  path,
  image: program.seo?.slika ? await ogImageUrl(program.seo.slika) : undefined,
  // Thin until the program's content arrives.
  noindex: program.uIzradi || (program.seo?.noindex ?? false),
};
const breadcrumbs = [
  { label: 'Početna', path: '/' },
  { label: 'Programi', path: '/programi/' },
  { label: program.naziv, path },
];

const hasPrice = priceLabel(program.prikazCene, program.cena) !== null;
const questions = await getFaq(program.kategorijaPitanja);
const faqLd = faqPage(questions.map((q) => q.data));
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs} renderBreadcrumbs={false} jsonLd={faqLd ? [faqLd] : []}>
  <section class="hero container">
    <Breadcrumbs items={breadcrumbs} />
    <span class="nadnaslov">{program.publika}</span>
    <h1>{program.naziv}</h1>
    <p class="intro">{program.opis}</p>
    {(program.uIzradi || program.status !== 'objavljeno') && (
      <p class="hero-badges">
        {program.uIzradi && <span class="program-draft">Sadržaj u izradi</span>}
        <StatusBadge status={program.status} />
      </p>
    )}
    <dl class="program-facts">
      <div><dt>Format</dt><Text as="dd" value={program.format} /></div>
      {hasPrice && <div><dt>Cena paketa</dt><dd><PriceNote prikaz={program.prikazCene} cena={program.cena} /></dd></div>}
    </dl>
    {program.pravnaNapomena && <Text as="p" class="hero-line" value={program.pravnaNapomena} />}
  </section>

  <FaqBlock questions={questions} category={program.kategorijaPitanja} />

  <div class="closing">
    <CtaBand
      title="Ako niste sigurni koji je sledeći korak, javite nam se."
      text="Potrebno je samo ime ili inicijali i jedan način kontakta. Javićemo vam se radi dogovora o terminu i vrsti razgovora."
      primary={{ label: 'Zakažite razgovor', href: '/kontakt/' }}
      secondary={{ label: 'Postavite pitanje', href: '/cesta-pitanja/' }}
    >
      <EmergencyNote />
    </CtaBand>
  </div>
</BaseLayout>

<style>
  .closing { background: var(--pesak-svetli); }
  .closing :global(.emergency-note) { margin-top: 24px; }

  .hero { display: flex; flex-direction: column; gap: 18px; padding-block: clamp(24px, 5vw, 64px) clamp(40px, 5vw, 64px); }
  h1 { margin: 0; max-width: 900px; }
  .intro { margin: 0; max-width: 720px; font-size: var(--uvod); color: var(--tekst-sekundarni); }
  .hero-badges { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin: 0; }
  .program-draft { font-size: var(--nadnaslov); color: var(--tekst-prigusen); }
  .hero-line { margin: 0; max-width: 720px; font-size: var(--tekst-mali); color: var(--tekst-prigusen); }

  .program-facts {
    display: flex; flex-direction: column; gap: 6px; max-width: 480px; margin: 0; padding-top: 14px;
    border-top: 1px solid var(--linija); font-size: var(--tekst-mali);
  }
  .program-facts div { display: flex; justify-content: space-between; gap: 12px; }
  .program-facts dt { color: var(--tekst-prigusen); }
  .program-facts :global(dd) { margin: 0; font-weight: 700; text-align: right; }
</style>
