---
// The book and the program (Book artboard). The week list comes from the same collections as the library.
import { Image } from 'astro:assets';
import { getEntry } from 'astro:content';
import BookCover from '../../components/BookCover.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Button from '../../components/Button.astro';
import Dialog from '../../components/Dialog.astro';
import FaqBlock from '../../components/FaqBlock.astro';
import Text from '../../components/Text.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getFaq, getStories, getWeeks } from '../../lib/content';
import { getImageAsset } from '../../lib/images';
import { book, faqPage } from '../../lib/jsonld';
import { href, site } from '../../lib/site';
import { BOOK_PATH, LIBRARY_PATH, storyPath } from '../../lib/stories';

const LEAD = 'Pedeset priča, deset nedelja i jedno jednostavno pravilo: priča ne daje gotov odgovor, već otvara pitanje koje više ne može lako da se zaobiđe.';
const seo = { title: 'Pričamo priču', description: LEAD, path: BOOK_PATH };
const breadcrumbs = [
  { label: 'Početna', path: '/' },
  { label: 'Pričamo priču', path: BOOK_PATH },
];

const knjiga = await getEntry('knjige', 'pricamo-pricu');
if (!knjiga) throw new Error('Nedostaje src/content/knjige/pricamo-pricu.json');

const stories = await getStories();
const weeks = (await getWeeks()).map(({ data }) => ({ ...data, stories: stories.filter((s) => s.data.nedelja === data.n) }));
// The story the page opens with: the third paragraph is the turn of the story.
const first = stories.find((s) => s.data.slug === 'okovani-slon')?.data;

const DAY = [
  { oznaka: '1', naslov: 'Priča', tekst: 'Kratka priča, parabola ili metafora, pročitana naglas.' },
  { oznaka: '2', naslov: 'Pitanja za razgovor', tekst: 'Dva do tri pitanja koja vode od junaka do ličnog primera.' },
  { oznaka: '3', naslov: 'Poruka za dan', tekst: 'Jedna misao koja sažima temu, bez propovedi.' },
  { oznaka: '4', naslov: 'Mali zadatak', tekst: 'Jedan konkretan, ostvariv korak do sledećeg dana.' },
  { oznaka: '+', naslov: 'Moj osvrt', tekst: 'Na kraju svake nedelje pet pitanja za tihi pregled.' },
];

const questions = await getFaq('pricamo-pricu');
const faqLd = faqPage(questions.map((q) => q.data));
const jsonLd = [book({ ...knjiga.data, path: BOOK_PATH }, site), ...(faqLd ? [faqLd] : [])];
---
<BaseLayout seo={seo} breadcrumbs={breadcrumbs} renderBreadcrumbs={false} jsonLd={jsonLd}>
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-text">
        <Breadcrumbs items={breadcrumbs} />
        <span class="nadnaslov">Knjiga i program narativnih grupa</span>
        <h1>Pričamo priču</h1>
        <p class="hero-lead">{LEAD}</p>
        <p>Dr Dragan Vukadinović razvio je program za svakodnevni grupni rad u bolničkom lečenju zavisnosti. Teme koje otvara, poricanje, odgovornost, stid, porodica i povratak u život, univerzalne su i za svakog čitaoca.</p>
        <div class="hero-actions">
          <a class="hero-btn hero-btn-solid" href={href(LIBRARY_PATH)}>Čitajte priče</a>
          <button type="button" class="hero-btn hero-btn-outline" data-dialog-open="kako-do-knjige">Kako do knjige</button>
        </div>
      </div>
      <div class="hero-cover">
        <BookCover naslov={knjiga.data.naslov} autor="Dragan Vukadinović">
          <Fragment slot="top">Program narativnih grupa</Fragment>
          <Fragment slot="title">Pričamo<br />priču</Fragment>
          <Fragment slot="sub">Radna sveska</Fragment>
          <Fragment slot="meta">Trezvenoumlje · 2026.</Fragment>
        </BookCover>
      </div>
    </div>
  </section>

  <section class="container split" aria-labelledby="uvod-h">
    <div class="split-title">
      <span class="nadnaslov">Iz knjige</span>
      <h2 id="uvod-h">Umesto uvoda</h2>
    </div>
    <div class="prose">
      <p>Priče su mnogo starije od psihoterapije. Hiljadama godina ljudi su kroz mitove, bajke, legende i priče pored ognjišta prenosili iskustvo o strahu, gubitku, izboru, grešci, odgovornosti, nadi i promeni.</p>
      <p>Umesto direktnog savetovanja, ubeđivanja ili suočavanja, nudi se priča. Ona stvara neutralniju distancu i omogućava da se najpre razmišlja o junaku, njegovim izborima i posledicama, a zatim, bez neposrednog pritiska, i o sebi.</p>
      <p>Šeherezada je možda najpoznatiji simbol takve snage pripovedanja: ona ne menja drugog naredbom, već pričom koja zadržava pažnju, održava odnos i postepeno otvara prostor za drugačiji pogled.</p>
      <p class="prose-accent">Dobra priča ne govori čoveku šta mora da misli. Ona ga dovodi do unutrašnjih pitanja, a svoje rešenje ne nameće kao nalog, već ga ostavlja kao mogućnost.</p>
    </div>
  </section>

  <section class="band-light" aria-labelledby="dan-h">
    <div class="container block">
      <h2 id="dan-h">Kako izgleda jedan dan</h2>
      <ol class="day">
        {DAY.map((step) => (
          <li>
            <span class="day-mark" aria-hidden="true">{step.oznaka}</span>
            <strong>{step.naslov}</strong>
            <span>{step.tekst}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="container block" aria-labelledby="teme-h">
    <div class="block-head">
      <div class="block-title">
        <span class="nadnaslov">Deset nedelja, pedeset priča</span>
        <h2 id="teme-h">Teme programa</h2>
      </div>
      <a class="text-link" href={href(LIBRARY_PATH)}>Sve priče <span aria-hidden="true">→</span></a>
    </div>
    <ol class="themes">
      {weeks.map((week) => (
        <li>
          <span class="theme-n"><span>{week.n}</span> nedelja</span>
          <strong>{week.tema}</strong>
          <ul>
            {week.stories.map((s) => <li>{s.data.naslov}</li>)}
          </ul>
        </li>
      ))}
    </ol>
  </section>

  {first && (
    <section class="band-sand" aria-labelledby="prva-h">
      <div class="container feature">
        <Image class="feature-image" src={getImageAsset('price/okovani-slon.webp')} alt="Slon vezan tankim lancem za mali kolac, ispred cirkuskog šatora" width={300} loading="lazy" />
        <div class="feature-text">
          <span class="nadnaslov">Priča za početak · 1. nedelja, utorak</span>
          <h2 id="prva-h">{first.naslov}</h2>
          <p class="feature-quote">{first.tekst[2]}</p>
          <span class="feature-source">{first.izvor}</span>
          <Button href={storyPath(first.slug)} class="feature-more">Pročitajte celu priču</Button>
        </div>
      </div>
    </section>
  )}

  <section class="container block" aria-labelledby="delovi-h">
    <h2 id="delovi-h">Tri dela knjige</h2>
    <div class="parts">
      <article class="part part-public">
        <span class="part-tag">Javno na sajtu</span>
        <h3>I · Radna sveska</h3>
        <p>Pedeset priča sa pitanjima, porukom za dan, malim zadatkom i nedeljnim osvrtom.</p>
        <a class="part-link" href={href(LIBRARY_PATH)}>Biblioteka priča <span aria-hidden="true">→</span></a>
      </article>
      <article class="part">
        <span class="part-tag">Za stručnjake, na zahtev</span>
        <h3>II · Dnevnik terapeuta</h3>
        <p>Uputstvo za voditelje grupa: struktura susreta, bezbednost i granice, terapijska logika svih pedeset dana.</p>
        <a class="part-link" href={href('/kontakt/')}>Za ustanove i NVO <span aria-hidden="true">→</span></a>
      </article>
      <article class="part">
        <span class="part-tag">Sažetak javno</span>
        <h3>III · Naučno-stručno obrazloženje</h3>
        <p>Teorijska osnova: posredna upotreba priče, grupna dinamika, rad sa ambivalencijom i prevencija recidiva.</p>
        <button type="button" class="part-link" data-dialog-open="sazetak">Pročitajte sažetak</button>
      </article>
    </div>
    <div class="dialogs">
      <Dialog id="kako-do-knjige" title="Kako do knjige">
        <dl class="book-facts">
          <dt>Naslov</dt><dd class="book-title">Pričamo priču – Radna sveska</dd>
          <dt>Autor</dt><dd>{knjiga.data.autor}</dd>
          {knjiga.data.izdanje && <Fragment><dt>Izdanje</dt><Text as="dd" value={knjiga.data.izdanje} /></Fragment>}
          {knjiga.data.format && <Fragment><dt>Format</dt><Text as="dd" value={knjiga.data.format} /></Fragment>}
          {knjiga.data.cenaNapomena && <Fragment><dt>Cena</dt><Text as="dd" value={knjiga.data.cenaNapomena} /></Fragment>}
        </dl>
        <p class="book-note">Ustanove, škole i NVO mogu dobiti i Dnevnik terapeuta uz dogovor o načinu primene.</p>
        <Button href="/kontakt/" class="book-ask">Pošaljite upit</Button>
      </Dialog>
      <Dialog id="sazetak" title="Teorijsko i kliničko obrazloženje strukturisanog narativnog grupnog programa">
        <span class="nadnaslov dialog-eyebrow">Deo III · Sažetak</span>
        <p>„Pričamo priču“ je strukturisan desetonedeljni narativni grupni program razvijen za svakodnevnu primenu u bolničkom lečenju bolesti zavisnosti. Program obuhvata 50 radnih dana i povezuje kratku priču ili metaforu sa terapijskom temom, pitanjima za razgovor, porukom za dan i malim konkretnim zadatkom.</p>
        <p>Teorijsko-klinička osnova oslanja se na posrednu upotrebu priče i metafore, grupnu dinamiku, rad sa ambivalencijom i otporom, prepoznavanje obrazaca i prevođenje uvida u konkretno ponašanje. U ovoj fazi program se predstavlja kao klinički razvijen i teorijski obrazložen model; njegova prihvatljivost, izvodljivost i klinički ishodi tek treba da budu sistematski procenjeni.</p>
        <p class="keywords"><strong>Ključne reči:</strong> bolesti zavisnosti; grupni rad; narativ; metafora; motivacija; psihosocijalne intervencije; prevencija recidiva; radna sveska</p>
      </Dialog>
    </div>
  </section>

  <section class="band-light" aria-labelledby="autor-h">
    <div class="container feature">
      <div class="feature-text">
        <span class="nadnaslov">Autorska stranica</span>
        <h2 id="autor-h">Morske zvezde</h2>
        <p class="feature-quote">Deda i unuka posle oluje šetaju plažom prekrivenom morskim zvezdama. Devojčica ih vraća u vodu, jednu po jednu. „Ima ih na hiljade. Kakvu razliku pravi to što radiš?“ Ona uzme još jednu: „Za ovu koju vratim u more, to pravi veliku razliku.“</p>
        <p class="author-note">Autor ne veruje previše u velike reči i velike preokrete preko noći. Više veruje u jedan razgovor, jedno dobro pitanje, jedan mali izbor i jednog čoveka kome je baš tog dana nešto bilo važno.</p>
        <p class="author-motto">Ne možemo promeniti sve. Ali ono što možemo, vredi uraditi.</p>
      </div>
      <Image class="feature-image feature-image-wide" src={getImageAsset('morske-zvezde.webp')} alt="Devojčica vraća morske zvezde u more dok je deda posmatra" width={360} loading="lazy" />
    </div>
  </section>

  <FaqBlock questions={questions} category="pricamo-pricu" />
</BaseLayout>

<style>
  h1, h2, h3, p { margin: 0; }
  .band-light { background: var(--pesak-svetli); }
  .band-sand { background: var(--pesak); }

  /* Hero */
  .hero { background: var(--zelena); color: var(--bela); --putanja-boja: var(--zelena-tinta); --putanja-link: var(--bela); }
  .hero-inner { display: flex; flex-wrap: wrap; align-items: center; gap: 56px; padding-block: clamp(32px, 6vw, 96px); }
  .hero-text { flex: 3 1 520px; min-width: 0; display: flex; flex-direction: column; gap: 20px; }
  .hero-text .nadnaslov { color: var(--zelena-tinta); }
  .hero h1 { font-size: var(--h1-hero); font-weight: 700; line-height: 1.02; letter-spacing: -0.02em; }
  .hero-text p { max-width: 640px; color: var(--zelena-tinta); }
  .hero-lead { font-family: var(--font-citat); font-size: var(--h3); line-height: 1.5; }
  .hero-actions { display: flex; flex-wrap: wrap; gap: 12px; padding-top: 8px; }
  .hero-btn {
    display: inline-flex; align-items: center; justify-content: center; min-height: 52px; padding: 8px 26px;
    border: 1.5px solid var(--bela); border-radius: 8px; cursor: pointer; text-decoration: none;
    font-family: var(--font-naslov); font-weight: 600; font-size: var(--tekst-vel); line-height: 1.2;
  }
  .hero-btn-solid { background: var(--bela); color: var(--zelena); }
  .hero-btn-solid:hover { background: var(--zelena-tinta); border-color: var(--zelena-tinta); color: var(--zelena-hover); }
  .hero-btn-outline { background: transparent; color: var(--bela); }
  .hero-btn-outline:hover { background: var(--zelena-hover); }
  .hero :focus-visible { outline-color: var(--bela); outline-offset: 3px; }

  .hero-cover { flex: 2 1 320px; min-width: 0; display: flex; justify-content: center; }
  .hero-cover :global(.book-cover) { width: min(340px, 100%); --cover-shadow: 0 30px 60px rgb(0 0 0 / 0.35); }

  /* Sections */
  .split { display: flex; flex-wrap: wrap; gap: 32px 72px; padding-block: clamp(56px, 7vw, 104px); }
  .split-title { flex: 1 1 280px; min-width: 0; display: flex; flex-direction: column; gap: 8px; }
  .prose { flex: 3 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 18px; font-family: var(--font-citat); font-size: var(--uvod); line-height: 1.7; }
  .prose-accent { font-style: italic; color: var(--zelena); }

  .block { display: flex; flex-direction: column; gap: 36px; padding-block: clamp(56px, 7vw, 96px); }
  .block-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 16px; }
  .block-title { display: flex; flex-direction: column; gap: 10px; }
  .text-link {
    display: inline-flex; align-items: center; gap: 6px; min-height: 44px;
    font-family: var(--font-naslov); font-weight: 600; text-underline-offset: 4px;
  }

  .day { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(220px, 100%), 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .day li { display: flex; flex-direction: column; gap: 10px; padding: 24px; border-radius: var(--radius-m); background: var(--bela); }
  .day-mark { font-family: var(--font-naslov); font-weight: 700; font-size: var(--h2); line-height: 1; color: var(--zelena); }
  .day strong { font-family: var(--font-naslov); font-weight: 600; font-size: var(--uvod); line-height: 1.3; }
  .day li > span:last-child { font-size: var(--tekst-vel); color: var(--tekst-sekundarni); }
  .day li:last-child { background: var(--zelena); color: var(--bela); }
  .day li:last-child .day-mark, .day li:last-child > span:last-child { color: var(--zelena-tinta); }

  .themes { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .themes > li { min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 22px 24px; border: 1px solid var(--linija); border-radius: var(--radius-m); }
  .theme-n { display: flex; align-items: baseline; gap: 10px; font-size: var(--nadnaslov); font-weight: 700; color: var(--tekst-prigusen); }
  .theme-n span { font-family: var(--font-naslov); font-size: var(--h2); line-height: 1; color: var(--zelena); }
  .themes strong { font-family: var(--font-naslov); font-weight: 600; font-size: var(--tekst-vel); line-height: 1.3; }
  .themes ul { display: flex; flex-direction: column; gap: 2px; margin: 0; padding-left: 18px; font-size: var(--tekst-mali); color: var(--tekst-sekundarni); }

  .feature { display: flex; flex-wrap: wrap; align-items: center; gap: 40px 64px; padding-block: clamp(56px, 7vw, 96px); }
  .feature-image { flex: 0 1 300px; width: 300px; max-width: 100%; height: auto; border-radius: var(--radius-m); }
  .feature-image-wide { flex-basis: 360px; width: 360px; }
  .feature-text { flex: 1 1 480px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .feature-quote { font-family: var(--font-citat); font-size: var(--uvod); line-height: 1.65; }
  .feature-source { font-size: var(--tekst-mali); font-style: italic; color: var(--tekst-prigusen); }
  .feature-text :global(.feature-more) { align-self: flex-start; }
  .author-note { color: var(--tekst-sekundarni); }
  .author-motto { font-family: var(--font-naslov); font-weight: 600; color: var(--zelena); }

  .parts { display: flex; flex-wrap: wrap; gap: 20px; }
  .part { flex: 1 1 320px; min-width: 0; display: flex; flex-direction: column; gap: 10px; padding: 28px; border: 1px solid var(--linija); border-radius: var(--radius-m); }
  .part-public { border: 1.5px solid var(--zelena); }
  .part-tag { align-self: flex-start; padding: 3px 12px; border-radius: 999px; background: var(--plava-tinta); color: var(--plava); font-size: var(--nadnaslov); font-weight: 700; }
  .part-public .part-tag { background: var(--zelena-tinta); color: var(--zelena); }
  .part p { color: var(--tekst-sekundarni); }
  .part-link {
    align-self: flex-start; display: inline-flex; align-items: center; gap: 6px; min-height: 44px; margin-top: auto; padding: 0;
    border: 0; background: none; color: var(--zelena); cursor: pointer;
    font-family: var(--font-naslov); font-weight: 600; font-size: var(--tekst-mali); text-decoration: underline; text-underline-offset: 4px;
  }
  .part-link:hover { color: var(--plava); }

  /* Overlays */
  .book-facts { display: grid; grid-template-columns: 140px 1fr; gap: 10px 16px; margin: 0; }
  .book-facts dt { color: var(--tekst-prigusen); }
  .book-facts :global(dd) { margin: 0; min-width: 0; overflow-wrap: anywhere; }
  .book-title { font-weight: 700; }
  .book-note { margin: 18px 0; font-size: var(--tekst-mali); color: var(--tekst-sekundarni); }
  .dialogs :global(.book-ask) { display: flex; min-height: 52px; }
  .dialogs :global(#sazetak .overlay-inner) { position: relative; }
  .dialogs :global(#sazetak .overlay-title) { padding-top: 28px; font-size: var(--h3); line-height: 1.25; }
  .dialog-eyebrow { position: absolute; top: 32px; left: 32px; right: 84px; line-height: 1.5; }
  .dialogs :global(#sazetak) p + p { margin-top: 16px; }
  .keywords { font-size: var(--tekst-sitan); color: var(--tekst-prigusen); }
  @media (min-width: 700px) {
    .dialogs :global(#kako-do-knjige) { max-width: 560px; }
    .dialogs :global(#sazetak) { max-width: 680px; }
  }

  /* Without JavaScript the buttons cannot open anything: both texts follow the three parts as plain blocks. */
  :global(html:not(.js)) .dialogs { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(320px, 100%), 1fr)); gap: 20px; align-items: start; }
  :global(html:not(.js)) .dialogs :global(dialog.overlay) {
    position: static; display: block; width: 100%; max-width: none; height: auto; margin: 0; border: 1px solid var(--linija);
  }
  :global(html:not(.js)) .dialogs :global(.overlay-inner) { min-height: 0; }
  :global(html:not(.js)) .dialogs :global(.overlay-close) { display: none; }
  :global(html:not(.js)) .dialogs :global(.overlay-title) { font-size: var(--h3); }
  :global(html:not(.js)) [data-dialog-open] { display: none; }

  @media (max-width: 699px) {
    .hero-inner { gap: 36px; }
    .hero-cover :global(.book-cover) { width: min(240px, 100%); }
    .book-facts { grid-template-columns: 1fr; gap: 2px; }
    .book-facts :global(dd) { margin-bottom: 8px; }
    .dialog-eyebrow { top: 24px; left: 20px; right: 64px; }
  }
</style>
